{
	"name": "wpui",
	"version": "1.0.0",
	"main": "index.js",
	"scripts": {
		"test": "npm run test:unit",
		"build": "wp-scripts build --webpack-no-externals",
		"check-engines": "wp-scripts check-engines",
		"check-licenses": "wp-scripts check-licenses",
		"format": "wp-scripts format",
		"lint": "npm run lint:js && npm run lint:css",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:md:docs": "wp-scripts lint-md-docs",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start --webpack-no-externals",
		"serve": "serve -s",
		"test:e2e": "playwright test",
		"test:unit": "wp-scripts test-unit-js",
		"prepare": "husky"
	},
	"dependencies": {
		"@wordpress/components": "^44.0.0",
		"@wordpress/compose": "^9.1.0",
		"@wordpress/element": "^10.1.0",
		"@wordpress/i18n": "^7.1.0",
		"@wordpress/icons": "^20.0.0",
		"@wordpress/scripts": "^37.1.0",
		"react": "^18.3.1",
		"react-content-loader": "^7.1.2",
		"react-dom": "^18.3.1",
		"react-markdown": "^10.1.0",
		"react-router-dom": "^7.18.5",
		"react-syntax-highlighter": "^16.1.2",
		"remark-gfm": "^4.0.1"
	},
	"author": "",
	"license": "ISC",
	"description": "",
	"devDependencies": {
		"@playwright/test": "^1.50.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@vitejs/plugin-react": "^6.3.0",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"lint-staged": "^17.6.1",
		"raw-loader": "^4.0.2",
		"rolldown": "^1.2.19",
		"serve": "^14.2.8",
		"vitest": "^5.1.1"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"wp-scripts format",
			"wp-scripts lint-js --fix"
		],
		"*.{css,scss}": [
			"wp-scripts format",
			"wp-scripts lint-style --fix"
		]
	}
}
